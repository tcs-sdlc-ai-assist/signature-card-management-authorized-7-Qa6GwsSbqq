# Environment Variables
# Copy this file to .env and fill in the values for your environment.

# Session timeout in milliseconds (default: 1800000 = 30 minutes)
VITE_SESSION_TIMEOUT_MS=1800000

# Maximum number of failed login attempts before account lockout (default: 5)
VITE_MAX_FAILED_LOGINS=5

# Token expiry duration in hours (default: 24)
VITE_TOKEN_EXPIRY_HOURS=24

# Maximum number of requests allowed within the rate limit window (default: 100)
VITE_RATE_LIMIT_MAX=100

# Application title displayed in the browser tab and header (default: SIG Card Management)
VITE_APP_TITLE=SIG Card Management